#include <winver.h>

1 ICON "delta.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     DELTA_VERSION_COMMAS
PRODUCTVERSION  DELTA_VERSION_COMMAS
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Delta contributors"
            VALUE "FileDescription",  "Delta performance overlay"
            VALUE "FileVersion",      DELTA_VERSION_STRING
            VALUE "InternalName",     "delta"
            VALUE "LegalCopyright",   "MIT or Apache-2.0"
            VALUE "OriginalFilename", "delta.exe"
            VALUE "ProductName",      "Delta"
            VALUE "ProductVersion",   DELTA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
